<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AudioSwitcher</AssemblyName>
    <!-- アイコンは tools/icon/MakeIcons.cs で作る。 -->
    <ApplicationIcon>Icons\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Icons\app.ico" LogicalName="AudioSwitcher.Icons.app.ico" />
    <EmbeddedResource Include="Icons\idle.ico" LogicalName="AudioSwitcher.Icons.idle.ico" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="3.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AudioSwitcher.Server\AudioSwitcher.Server.csproj" />
    <ProjectReference Include="..\AudioSwitcher.Core\AudioSwitcher.Core.csproj" />
  </ItemGroup>

</Project>
